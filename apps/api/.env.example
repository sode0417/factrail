# =========================
# Application
# =========================
NODE_ENV=development

# ⚠️ 実際にサーバが listen するポートは PORT。main.ts が
#    `process.env.PORT ?? 3000` を見ており、未設定だと 3000 になって
#    web(:3000) と衝突する。API_PORT はコードから参照されていない。
PORT=3001
API_PORT=3001

# =========================
# Database (PostgreSQL)
# =========================
# Mac mini のローカル PostgreSQL に接続する
DATABASE_URL=postgresql://factrail:YOUR_PASSWORD@localhost:5432/factrail?schema=factrail
# Prisma の directUrl（schema.prisma で参照）。マイグレーション用の直結先
DIRECT_URL=postgresql://factrail:YOUR_PASSWORD@localhost:5432/factrail?schema=factrail

# =========================
# Security
# =========================
# 32文字以上のランダム文字列
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM

# =========================
# Slack (OAuth)
# =========================
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=http://localhost:3000/setup/slack/callback

# Slack DM 収集（仕事用ワークスペース）
SLACK_BOT_TOKEN_WORK=xoxb-YOUR-BOT-TOKEN
SLACK_USER_ID_WORK=U_YOUR_SLACK_USER_ID
SLACK_COLLECTOR_CATEGORY_ID=
SLACK_COLLECTOR_PROJECT_ID=

# =========================
# GitHub
# =========================
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET

# =========================
# Redis (認証セッション用。Bull Queue は 2026-03-22 に廃止済み)
# =========================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SESSION_DB=1

# =========================
# Authentication
# =========================
# JWT署名用シークレット（32文字以上）
JWT_SECRET=CHANGE_ME_VERY_LONG_SECRET_KEY_FOR_JWT_SIGNING_AT_LEAST_32_CHARACTERS

# API キー認証（api-key.guard.ts）。カンマ区切りで許可キーを列挙する
API_KEYS=
# API キー認証で使うユーザー。未設定ならデフォルトユーザー
FACTRAIL_USER_ID=

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# ⚠️ 実環境の .env には存在するが、apps/api/src からの参照が見つからない。
#    使われていない可能性があるため、新規構築時は未設定でよい。
GOOGLE_CALENDAR_REFRESH_TOKEN=

# GitHub OAuth
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# =========================
# Browser Collector
# =========================
BROWSER_COLLECTOR_ENABLED=true
CHROME_PROFILE_PATH=~/Library/Application Support/Google/Chrome/Default
LLM_PROVIDER=claude-cli
# Ollama（LLM_PROVIDER=ollama の場合のみ使用）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# =========================
# URL / CORS
# =========================
# Frontend URL (CORS + OAuth Redirect)
WEB_URL=http://localhost:3000
# CORS 許可オリジン（カンマ区切り）。未設定時は main.ts の既定値
ALLOWED_ORIGINS=http://localhost:3000
# API 自身の公開 URL。GitHub Webhook の登録先として使う（未設定だと
# Webhook 作成をスキップする）
API_URL=http://localhost:3001
