# =========================
# Application
# =========================
NODE_ENV=development
API_PORT=3001

# =========================
# Database (PostgreSQL)
# =========================
# Mac mini のローカル PostgreSQL に接続する
DATABASE_URL=postgresql://factrail:YOUR_PASSWORD@localhost:5432/factrail?schema=factrail

# =========================
# Security
# =========================
# 32文字以上のランダム文字列
ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MINIMUM

# =========================
# Slack (OAuth)
# =========================
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=http://localhost:3000/setup/slack/callback

# Slack DM 収集（仕事用ワークスペース）
SLACK_BOT_TOKEN_WORK=xoxb-YOUR-BOT-TOKEN
SLACK_USER_ID_WORK=U_YOUR_SLACK_USER_ID
SLACK_COLLECTOR_CATEGORY_ID=
SLACK_COLLECTOR_PROJECT_ID=

# =========================
# GitHub
# =========================
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET

# =========================
# Redis (認証セッション用。Bull Queue は 2026-03-22 に廃止済み)
# =========================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SESSION_DB=1

# =========================
# Authentication
# =========================
# JWT署名用シークレット（32文字以上）
JWT_SECRET=CHANGE_ME_VERY_LONG_SECRET_KEY_FOR_JWT_SIGNING_AT_LEAST_32_CHARACTERS

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# =========================
# Browser Collector
# =========================
BROWSER_COLLECTOR_ENABLED=true
CHROME_PROFILE_PATH=~/Library/Application Support/Google/Chrome/Default
LLM_PROVIDER=claude-cli
# Ollama（LLM_PROVIDER=ollama の場合のみ使用）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Frontend URL (CORS + OAuth Redirect)
WEB_URL=http://localhost:3000
