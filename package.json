{
  "name": "factrail",
  "version": "1.0.0",
  "private": true,
  "description": "Fact Trail - Log infrastructure for personal activities",
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "build:api": "pnpm --filter api build",
    "start:api": "pnpm --filter api start",
    "lint:api": "pnpm --filter api lint",
    "format:api": "pnpm --filter api format",
    "lint:web": "pnpm --filter web lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.18.1 <2",
      "qs": ">=6.15.2 <7",
      "multer": ">=2.2.0 <3",
      "form-data": ">=4.0.6 <5",
      "uuid": ">=11.1.1 <15",
      "@babel/core": ">=7.29.6 <8",
      "effect": ">=3.20.0 <4",
      "defu": ">=6.1.5 <7",
      "lodash": ">=4.18.0 <5",
      "ws": ">=8.20.1 <9",
      "postcss": ">=8.5.23 <9",
      "sharp": ">=0.35.3 <0.36",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@2": ">=2.1.2 <3",
      "brace-expansion@5": ">=5.0.8 <6",
      "fast-uri@3": ">=3.1.4 <4",
      "js-yaml@3": ">=3.15.0 <4",
      "js-yaml@4": ">=4.3.0 <5",
      "nanoid@3": ">=3.3.17 <4",
      "glob@10": ">=10.5.0 <11",
      "picomatch@4": ">=4.0.4 <5",
      "tmp": ">=0.2.7 <0.3",
      "express>path-to-regexp": "0.1.13"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "better-sqlite3",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
