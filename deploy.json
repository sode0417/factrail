{
  "services": [
    {
      "name": "api",
      "type": "node",
      "dir": "apps/api",
      "port": 3001,
      "build_cmd": "pnpm run build",
      "start_cmd": "pnpm run start",
      "log_file": "~/Library/Logs/factrail-api.log",
      "error_log": "~/Library/Logs/factrail-api.error.log"
    },
    {
      "name": "web",
      "type": "nextjs",
      "dir": "apps/web",
      "port": 3000,
      "build_cmd": "pnpm run build",
      "start_cmd": "pnpm exec next start -- -p 3000"
    }
  ]
}
